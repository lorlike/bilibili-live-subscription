{
  "name": "bilibili-live-subscription",
  "version": "1.0.0",
  "description": "监听 B 站直播间开播并持久化记录",
  "type": "module",
  "main": "src/cli.ts",
  "bin": {
    "bls": "src/cli.ts"
  },
  "scripts": {
    "dev": "tsx src/cli.ts web",
    "start": "tsx src/cli.ts start",
    "web": "tsx src/cli.ts web",
    "listen": "tsx src/cli.ts listen",
    "user:add": "tsx src/cli.ts user:add",
    "user:list": "tsx src/cli.ts user:list",
    "list": "tsx src/cli.ts list",
    "today": "tsx src/cli.ts today",
    "rooms": "tsx src/cli.ts rooms",
    "info": "tsx src/cli.ts info",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "bilibili",
    "live",
    "subscription"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "dotenv": "^18.0.9",
    "hono": "^4.13.17",
    "tiny-bilibili-ws": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@12.18.0",
  "files": [
    "src",
    "web"
  ]
}
