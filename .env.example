# Bilibili Cookie，从网页版 F12 复制（用于规避风控）
BILIBILI_COOKIE=
# Cookie 对应的 UID。
# 重要：填非 0 的 uid 会被弹幕服务器直接断开（close 1006），
# 保持 0 即可正常获取弹幕用户名（已验证）。
UID=0

# SQLite 数据库路径
DB_PATH=data/live.db
# 记录保留天数，0 表示永久保留
RETENTION_DAYS=0

# 断线重连间隔（毫秒）
RECONNECT_TIME=5000
# 心跳间隔（毫秒）
HEARTBEAT_TIME=30000
# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# Web 界面
WEB_HOST=127.0.0.1
WEB_PORT=3000

# JWT 签名密钥。不填则每次启动随机生成 —— 重启后所有登录失效。
# Docker 部署时**必须显式设置**（docker-compose.yml 里是必填项），
# 否则每次重建容器都会把所有人都踢下线。
# 生成方式：openssl rand -hex 32
# JWT_SECRET=
# 登录有效期（小时），默认 24
JWT_TTL_HOURS=24

# 走 https 反代时设 1，cookie 会加 Secure；
# 本机 http 调试必须留空，否则浏览器不回传 cookie，登录会立刻被踢回。
# COOKIE_SECURE=1

# 只启 Web 不启监听（配合 pnpm listen 分进程部署时才需要）
# WEB_ONLY=1

# 监听进程与数据库同步房间的间隔（毫秒），默认 5 秒
SYNC_INTERVAL_MS=5000

# ---- Docker 部署 ----
# 端口绑定。默认 0.0.0.0（外网可直接访问）；
# 只走本机反代时设 BIND_IP=127.0.0.1
BIND_IP=0.0.0.0
HOST_PORT=3000

# 只有前面确实挂了可信反向代理（nginx/caddy）时才设 1。
# 设了才会读取 X-Forwarded-For 来区分客户端做登录限流；
# 直接暴露时保持 0，否则别人可以伪造该头绕过限流。
TRUST_PROXY=0
