# Bilibili Cookie，从网页版 F12 复制（用于规避风控）
BILIBILI_COOKIE=
# Cookie 对应的 UID。
# 重要：填非 0 的 uid 会被弹幕服务器直接断开（close 1006），
# 保持 0 即可正常获取弹幕用户名（已验证）。
UID=0

# 房间清单（JSON）
ROOMS_FILE=rooms.toml
# SQLite 数据库路径
DB_PATH=data/live.db
# 记录保留天数，0 表示永久保留
RETENTION_DAYS=0

# 断线重连间隔（毫秒）
RECONNECT_TIME=5000
# 心跳间隔（毫秒）
HEARTBEAT_TIME=30000
# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# Web 界面
WEB_HOST=127.0.0.1
WEB_PORT=3000
